# قاعدة البيانات (Neon Postgres)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# NextAuth
AUTH_SECRET="generate-with: openssl rand -base64 33"
AUTH_URL="https://your-domain.vercel.app"

# GitHub OAuth App (github.com/settings/developers)
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Google OAuth (console.cloud.google.com -> APIs & Services -> Credentials)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Cloudflare Turnstile (dash.cloudflare.com -> Turnstile)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# سر توقيع كوكيز التحقق من الإنسان (اي نص عشوائي طويل)
HUMAN_CHECK_SECRET="generate-with: openssl rand -base64 33"
